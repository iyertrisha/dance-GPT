# Postgres (Docker: see docker-compose.yml — mapped to host port 5433)
DATABASE_URL=postgresql://dancegpt:dancegpt@127.0.0.1:5433/dancegpt

GROQ_API_KEY=

# Google Cloud Vision (optional)
# For service account key: set path to JSON key file.
# For ADC (gcloud auth application-default login): leave unset or comment out.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Vector store (optional; defaults to <repo>/data/lancedb if unset)
# LANCEDB_PATH=data/lancedb

# Internal service URLs — use 127.0.0.1 (not localhost) if Docker also binds port 8000
AI_SERVICE_URL=http://127.0.0.1:8000

# RAG tuning (Python ai/ service; see ai/.env.example)
# RAG_RETRIEVE_K=24
# RAG_CONTEXT_K=5
# RAG_LEVEL_MODE=auto
# CONTEXTUAL_CHUNKING=0
