# LLM (Groq) - get key at console.groq.com
GROQ_API_KEY=

# Relative to repo root (same folder as docker-compose.yml), not to ai/
LANCEDB_PATH=data/lancedb
DATABASE_URL=postgresql://dancegpt:dancegpt@127.0.0.1:5433/dancegpt

# RAG (optional; defaults are sane for production-like quality)
# RAG_RETRIEVE_K=24
# RAG_CONTEXT_K=5
# RAG_ENABLE_RERANK=1
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAG_ENABLE_HYBRID_RRF=1
# RAG_RRF_K=60
# RAG_LEVEL_MODE=auto
# strict | soft | auto (auto = strict then soft fallback if too few hits)
# RAG_LEVEL_PENALTY=0.15
# RAG_TWO_STAGE_MIN_ROWS=3
# RAG_ENABLE_MQE=0
# RAG_MQE_VARIANTS=3
# RAG_ENABLE_HYDE=0
# RAG_ENABLE_CRAG=1
# RAG_ENABLE_CARD_SANITY=1
# RAG_CARD_MIN_GROUNDED=3

# Index-time: prepend LLM doc summary to each chunk (requires GROQ_API_KEY; reindex after toggling)
# CONTEXTUAL_CHUNKING=0
